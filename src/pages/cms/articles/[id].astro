---
export const prerender = false;

import CMSLayout from '../../../layouts/CMSLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { query } from '../../../lib/db';

const user = await getSessionUser(Astro.cookies.get('session')?.value);
if (!user) return Astro.redirect('/cms/login');

const { id } = Astro.params;

const [articleRes, catRes] = await Promise.all([
  query('SELECT * FROM articles WHERE id = $1', [id]).catch(() => ({ rows: [] })),
  query('SELECT id, name FROM categories ORDER BY name').catch(() => ({ rows: [] })),
]);

const article = articleRes.rows[0];
if (!article) return Astro.redirect('/cms/articles');

const categories = catRes.rows;
const contentJson = JSON.stringify(article.content || '');
---

<CMSLayout title={`Edit: ${article.title}`} user={user} currentPage="articles">

  <div style="margin-bottom: 16px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
    <a href="/cms/articles" class="btn btn-secondary btn-sm">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="15,18 9,12 15,6"/></svg>
      Back to Articles
    </a>
    <div style="display:flex; gap:8px;">
      <a href={`/blog/${article.slug}`} target="_blank" class="btn btn-secondary btn-sm">View Live →</a>
      <button class="btn btn-danger btn-sm" onclick={`deleteArticle(${article.id}, '${article.title.replace(/'/g, "\\'")}', '${article.slug}')`}>Delete</button>
    </div>
  </div>

  <div id="alert-container"></div>

  <form id="article-form">
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">

      <div>
        <div class="cms-card" style="margin-bottom: 20px;">
          <div class="cms-card-header"><h2>Article Content</h2></div>
          <div class="cms-card-body">

            <div class="form-group">
              <label class="form-label">Title <span style="color:#ef4444">*</span></label>
              <input type="text" id="title" name="title" class="form-input" value={article.title} required>
            </div>

            <div class="form-group">
              <label class="form-label">Slug</label>
              <input type="text" id="slug" name="slug" class="form-input" value={article.slug}>
              <div class="form-hint">URL: /blog/{article.slug}</div>
            </div>

            <div class="form-group">
              <label class="form-label">Excerpt</label>
              <textarea id="excerpt" name="excerpt" class="form-textarea" rows="3">{article.excerpt}</textarea>
            </div>

            <div class="form-group">
              <label class="form-label">Content</label>
              <textarea id="content-editor"></textarea>
              <input type="hidden" id="content" name="content">
            </div>

          </div>
        </div>
      </div>

      <div>
        <div class="cms-card" style="margin-bottom: 16px;">
          <div class="cms-card-header"><h2>Settings</h2></div>
          <div class="cms-card-body">

            <div class="form-group">
              <label class="form-label">Category</label>
              <select id="category_id" name="category_id" class="form-select">
                <option value="">— No category —</option>
                {categories.map((c: any) => (
                  <option value={c.id} selected={article.category_id === c.id}>{c.name}</option>
                ))}
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Status</label>
              <select id="status" name="status" class="form-select">
                <option value="draft" selected={article.status === 'draft'}>Draft</option>
                <option value="published" selected={article.status === 'published'}>Published</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Author Name</label>
              <input type="text" id="author_name" name="author_name" class="form-input" value={article.author_name ?? ''}>
            </div>

            <div class="form-group">
              <label class="form-label">Cover Image URL</label>
              <input type="text" id="cover_image" name="cover_image" class="form-input" value={article.cover_image ?? ''} placeholder="/img/blog/1.jpg or https://…">
              {article.cover_image && (
                <img src={article.cover_image} alt="cover preview" style="margin-top:8px; width:100%; max-height:160px; object-fit:cover; border-radius:6px; border:1px solid #e2e8f0;" />
              )}
            </div>

            <div class="form-group">
              <label class="form-label">Tags</label>
              <input type="text" id="tags" name="tags" class="form-input" value={article.tags ?? ''} placeholder="design, technology, innovation">
              <div class="form-hint">Comma-separated tags</div>
            </div>

          </div>
        </div>

        <div class="cms-card" style="margin-bottom: 16px;">
          <div class="cms-card-header"><h2>SEO Meta</h2></div>
          <div class="cms-card-body">

            <div class="form-group">
              <label class="form-label">Meta Title</label>
              <input type="text" id="meta_title" name="meta_title" class="form-input" value={article.meta_title ?? ''} placeholder="Defaults to article title if empty">
              <div class="form-hint">Recommended: 50–60 characters</div>
            </div>

            <div class="form-group">
              <label class="form-label">Meta Description</label>
              <textarea id="meta_description" name="meta_description" class="form-textarea" rows="3" placeholder="Defaults to excerpt if empty">{article.meta_description ?? ''}</textarea>
              <div class="form-hint">Recommended: 120–160 characters</div>
            </div>

          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center; padding:12px;" id="submit-btn">
          Save Changes
        </button>
      </div>

    </div>
  </form>

  <script src="/tinymce/tinymce.min.js" is:inline></script>
  <script define:vars={{ contentJson, articleId: article.id }}>
    tinymce.init({
      selector: '#content-editor',
      license_key: 'gpl',
      base_url: '/tinymce',
      suffix: '.min',
      plugins: 'table image link lists code wordcount',
      toolbar: 'undo redo | blocks | bold italic underline strikethrough | bullist numlist | table | link image | blockquote code | removeformat',
      min_height: 400,
      image_title: true,
      automatic_uploads: true,
      images_upload_handler: async (blobInfo) => {
        const fd = new FormData();
        fd.append('file', blobInfo.blob(), blobInfo.filename());
        const res = await fetch('/api/cms/upload-image', { method: 'POST', body: fd });
        if (!res.ok) throw new Error('Upload failed');
        const data = await res.json();
        return data.location;
      },
      content_style: 'body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; font-size: 15px; line-height: 1.6; padding: 8px 16px; }',
      setup: (editor) => {
        editor.on('init', () => {
          if (contentJson) {
            try { const h = JSON.parse(contentJson); if (h) editor.setContent(h); } catch {}
          }
        });
      },
    });

    document.getElementById('article-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const _ed = tinymce.get('content-editor');
      document.getElementById('content').value = _ed ? _ed.getContent() : '';

      const btn = document.getElementById('submit-btn');
      btn.disabled = true;
      btn.textContent = 'Saving…';

      const alertEl = document.getElementById('alert-container');
      alertEl.innerHTML = '';

      const data = {
        title: document.getElementById('title').value,
        slug: document.getElementById('slug').value,
        excerpt: document.getElementById('excerpt').value,
        content: document.getElementById('content').value,
        cover_image: document.getElementById('cover_image').value,
        author_name: document.getElementById('author_name').value,
        category_id: document.getElementById('category_id').value || null,
        status: document.getElementById('status').value,
        tags: document.getElementById('tags').value,
        meta_title: document.getElementById('meta_title').value,
        meta_description: document.getElementById('meta_description').value,
      };

      try {
        const res = await fetch(`/api/cms/articles/${articleId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (res.ok) {
          alertEl.innerHTML = `<div class="alert alert-success">Article saved successfully!</div>`;
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          alertEl.innerHTML = `<div class="alert alert-error">${json.error || 'Failed to save.'}</div>`;
        }
      } catch {
        alertEl.innerHTML = `<div class="alert alert-error">Server error. Please try again.</div>`;
      } finally {
        btn.disabled = false;
        btn.textContent = 'Save Changes';
      }
    });

    function deleteArticle(id, title, slug) {
      if (!confirm(`Delete "${title}"? This cannot be undone.`)) return;
      fetch(`/api/cms/articles/${id}`, { method: 'DELETE' })
        .then(r => r.ok ? window.location.href = '/cms/articles' : alert('Delete failed.'))
        .catch(() => alert('Delete failed.'));
    }
    window.deleteArticle = deleteArticle;
  </script>
</CMSLayout>
