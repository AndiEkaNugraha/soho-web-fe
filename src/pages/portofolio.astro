---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { query } from '../lib/db';
import { getPageSeo } from '../lib/seo';

const seo = await getPageSeo('works');

const works = await query(
  `SELECT id, title, slug, client_name, category, year, cover_image, accent_color
   FROM works WHERE status = 'published' ORDER BY sort_order ASC, created_at DESC`
).then(r => r.rows).catch(() => []);
---

<BaseLayout
  title={seo?.meta_title || 'Works | Soho Solusi Digital'}
  description={seo?.meta_description || 'Explore our portfolio of websites, custom software, and digital systems.'}
  ogImage={seo?.og_image || ''}
>
  <div class="mil-content">
    <div class="mil-main-transition">

      <!-- banner -->
      <div class="mil-inner-banner">
        <div class="mil-banner-content mil-up">
          <div class="mil-animation-frame">
            <div class="mil-animation mil-position-4 mil-dark mil-scale" data-value-1="6" data-value-2="1.4"></div>
          </div>
          <div class="container">
            <ul class="mil-breadcrumbs mil-mb-60">
              <li><a href="/">Beranda</a></li>
              <li><a href="/portofolio">Portofolio</a></li>
            </ul>
            <h1 class="mil-mb-60">Wujudkan Dunia <br> yang <span class="mil-thin">Lebih Baik Hari Ini</span></h1>
            <a href="#portfolio" class="mil-link mil-dark mil-arrow-place mil-down-arrow">
              <span>Portofolio Kami</span>
            </a>
          </div>
        </div>
      </div>
      <!-- banner end -->

      <!-- portfolio -->
      <section id="portfolio">
        <div class="container mil-portfolio mil-p-120-60">
          {works.length === 0 ? (
            <p class="mil-up" style="color:#888; padding: 60px 0;">No published projects yet.</p>
          ) : (
            <div class="row justify-content-between align-items-center">
              {works.map((w: any) => (
                <div class="col-lg-6">
                  <a href={`/portofolio/${w.slug}`} class="mil-portfolio-item mil-mb-60">
                    <div class="mil-cover-frame mil-vert mil-up" style="padding-bottom: 72%;">
                      <div class="mil-cover">
                        {w.cover_image
                          ? <img src={w.cover_image} width="100%" height="auto" alt={w.title} />
                          : <div style="background:#f0f0f0; position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:#aaa;">No image</div>
                        }
                      </div>
                    </div>
                    <div class="mil-descr">
                      <div class="mil-labels mil-up mil-mb-15">
                        {w.category && (
                          <div class="mil-label mil-upper mil-accent" style={`color: ${w.accent_color || '#000'};`}>
                            {w.category}
                          </div>
                        )}
                        {w.year && <div class="mil-label mil-upper">{w.year}</div>}
                      </div>
                      <h4 class="mil-up">{w.title}</h4>
                    </div>
                  </a>
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
      <!-- portfolio end -->

    </div>
  </div>
</BaseLayout>
