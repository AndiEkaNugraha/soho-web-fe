# ── External Backend API ──────────────────────────────
BE_API_TOKEN=your_api_token_here
BE_API_BASE_URL=

# ── PostgreSQL Database ───────────────────────────────
# Docker: postgresql://postgres:yourpassword@db:5432/sohoweb
# Local:  postgresql://postgres:yourpassword@localhost:5432/sohoweb
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/sohoweb
DB_PASSWORD=yourpassword

# ── Google OAuth 2.0 ─────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4321/api/auth/callback (dev)
#                          https://yourdomain.com/api/auth/callback (prod)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/callback

# ── CMS Access Control ────────────────────────────────
# Comma-separated list of Google emails allowed to access the CMS.
# Leave empty to allow any Google account (not recommended for production).
CMS_ALLOWED_EMAILS=admin@sohodigital.id
