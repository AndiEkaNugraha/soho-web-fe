---
export const prerender = false;

import CMSLayout from '../../../layouts/CMSLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { query } from '../../../lib/db';

const user = await getSessionUser(Astro.cookies.get('session')?.value);
if (!user) return Astro.redirect('/cms/login');

const categories = await query('SELECT id, name FROM categories ORDER BY name')
  .then(r => r.rows).catch(() => []);
---

<CMSLayout title="New Article" user={user} currentPage="articles">
  <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css">
  <style>
    .ql-editor { min-height: 320px; font-size: 15px; font-family: inherit; }
    .ql-toolbar { border-radius: 7px 7px 0 0; border-color: #e2e8f0 !important; }
    .ql-container { border-radius: 0 0 7px 7px; border-color: #e2e8f0 !important; }
    .ql-container:focus-within { border-color: #6366f1 !important; }
  </style>

  <div style="margin-bottom: 16px;">
    <a href="/cms/articles" class="btn btn-secondary btn-sm">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="15,18 9,12 15,6"/></svg>
      Back to Articles
    </a>
  </div>

  <div id="alert-container"></div>

  <form id="article-form">
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">

      <div>
        <div class="cms-card" style="margin-bottom: 20px;">
          <div class="cms-card-header"><h2>Article Content</h2></div>
          <div class="cms-card-body">

            <div class="form-group">
              <label class="form-label">Title <span style="color:#ef4444">*</span></label>
              <input type="text" id="title" name="title" class="form-input" placeholder="Article title…" required>
            </div>

            <div class="form-group">
              <label class="form-label">Excerpt</label>
              <textarea id="excerpt" name="excerpt" class="form-textarea" placeholder="Short description shown on listing pages…" rows="3"></textarea>
            </div>

            <div class="form-group">
              <label class="form-label">Content</label>
              <div id="quill-editor"></div>
              <input type="hidden" id="content" name="content">
            </div>

          </div>
        </div>
      </div>

      <div>
        <div class="cms-card" style="margin-bottom: 16px;">
          <div class="cms-card-header"><h2>Settings</h2></div>
          <div class="cms-card-body">

            <div class="form-group">
              <label class="form-label">Category</label>
              <select id="category_id" name="category_id" class="form-select">
                <option value="">— No category —</option>
                {categories.map((c: any) => <option value={c.id}>{c.name}</option>)}
              </select>
              <div class="form-hint"><a href="/cms/categories" target="_blank" style="color:#6366f1; font-size:11.5px;">Manage categories →</a></div>
            </div>

            <div class="form-group">
              <label class="form-label">Status</label>
              <select id="status" name="status" class="form-select">
                <option value="draft">Draft</option>
                <option value="published">Published</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Author Name</label>
              <input type="text" id="author_name" name="author_name" class="form-input" placeholder="e.g. Soho Team">
            </div>

            <div class="form-group">
              <label class="form-label">Cover Image URL</label>
              <input type="text" id="cover_image" name="cover_image" class="form-input" placeholder="/img/blog/1.jpg or https://…">
              <div class="form-hint">Use path from /public/img/ or an external URL</div>
            </div>

            <div class="form-group">
              <label class="form-label">Tags</label>
              <input type="text" id="tags" name="tags" class="form-input" placeholder="design, technology, innovation">
              <div class="form-hint">Comma-separated tags</div>
            </div>

          </div>
        </div>

        <div class="cms-card" style="margin-bottom: 16px;">
          <div class="cms-card-header"><h2>SEO Meta</h2></div>
          <div class="cms-card-body">

            <div class="form-group">
              <label class="form-label">Meta Title</label>
              <input type="text" id="meta_title" name="meta_title" class="form-input" placeholder="Defaults to article title if empty">
              <div class="form-hint">Recommended: 50–60 characters</div>
            </div>

            <div class="form-group">
              <label class="form-label">Meta Description</label>
              <textarea id="meta_description" name="meta_description" class="form-textarea" rows="3" placeholder="Defaults to excerpt if empty"></textarea>
              <div class="form-hint">Recommended: 120–160 characters</div>
            </div>

          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; padding: 12px;" id="submit-btn">
          Save Article
        </button>
      </div>

    </div>
  </form>

  <script src="https://cdn.quilljs.com/1.3.7/quill.min.js" is:inline></script>
  <script is:inline>
    const quill = new Quill('#quill-editor', {
      theme: 'snow',
      modules: {
        toolbar: [
          [{ header: [1, 2, 3, false] }],
          ['bold', 'italic', 'underline', 'strike'],
          ['blockquote', 'code-block'],
          [{ list: 'ordered' }, { list: 'bullet' }],
          ['link', 'image'],
          ['clean']
        ]
      }
    });

    document.getElementById('article-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      document.getElementById('content').value = quill.root.innerHTML === '<p><br></p>' ? '' : quill.root.innerHTML;

      const btn = document.getElementById('submit-btn');
      btn.disabled = true;
      btn.textContent = 'Saving…';

      const alertEl = document.getElementById('alert-container');
      alertEl.innerHTML = '';

      const data = {
        title: document.getElementById('title').value,
        excerpt: document.getElementById('excerpt').value,
        content: document.getElementById('content').value,
        cover_image: document.getElementById('cover_image').value,
        author_name: document.getElementById('author_name').value,
        category_id: document.getElementById('category_id').value || null,
        status: document.getElementById('status').value,
        tags: document.getElementById('tags').value,
        meta_title: document.getElementById('meta_title').value,
        meta_description: document.getElementById('meta_description').value,
      };

      try {
        const res = await fetch('/api/cms/articles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (res.ok) {
          window.location.href = '/cms/articles';
        } else {
          alertEl.innerHTML = `<div class="alert alert-error">${json.error || 'Failed to save.'}</div>`;
          btn.disabled = false;
          btn.textContent = 'Save Article';
        }
      } catch {
        alertEl.innerHTML = `<div class="alert alert-error">Server error. Please try again.</div>`;
        btn.disabled = false;
        btn.textContent = 'Save Article';
      }
    });
  </script>
</CMSLayout>
