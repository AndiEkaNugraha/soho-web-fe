---
export interface Props {
  title: string;
  user: {
    name: string;
    email: string;
    avatar?: string;
  };
  currentPage?: string;
}

const { title, user, currentPage } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} – Soho CMS</title>
  <link rel="icon" type="image/png" href="/fav.png">
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif; background: #f8fafc; color: #1e293b; line-height: 1.5; }

    .cms-wrapper { display: flex; min-height: 100vh; }

    /* ── Sidebar ── */
    .cms-sidebar {
      width: 256px;
      min-height: 100vh;
      background: #0f172a;
      color: #94a3b8;
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0; left: 0;
      z-index: 100;
    }
    .cms-sidebar-logo {
      padding: 22px 20px 18px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .cms-sidebar-logo img { height: 30px; width: auto; filter: brightness(0) invert(1); display: block; }
    .cms-sidebar-logo span { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: #475569; margin-top: 5px; display: block; }

    .cms-nav { flex: 1; padding: 14px 10px; overflow-y: auto; }
    .cms-nav-label { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: #475569; padding: 10px 10px 6px; display: block; }
    .cms-nav a {
      display: flex; align-items: center; gap: 11px;
      padding: 9px 10px; border-radius: 7px;
      color: #94a3b8; text-decoration: none;
      font-size: 13.5px; font-weight: 500;
      transition: all 0.13s; margin-bottom: 2px;
    }
    .cms-nav a:hover { background: rgba(255,255,255,0.06); color: #e2e8f0; }
    .cms-nav a.active { background: #6366f1; color: #fff; }
    .cms-nav a svg { width: 17px; height: 17px; flex-shrink: 0; }

    .cms-sidebar-footer {
      padding: 14px;
      border-top: 1px solid rgba(255,255,255,0.07);
    }
    .cms-user-card { display: flex; align-items: center; gap: 10px; padding: 8px; margin-bottom: 10px; }
    .cms-user-avatar { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }
    .cms-user-avatar-placeholder {
      width: 34px; height: 34px; border-radius: 50%;
      background: #6366f1; display: flex; align-items: center; justify-content: center;
      color: white; font-size: 13px; font-weight: 700; flex-shrink: 0;
    }
    .cms-user-info { flex: 1; min-width: 0; }
    .cms-user-name { font-size: 13px; font-weight: 600; color: #e2e8f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cms-user-email { font-size: 11px; color: #64748b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .cms-logout-btn {
      display: flex; align-items: center; justify-content: center; gap: 7px;
      width: 100%; padding: 8px; background: rgba(239,68,68,0.1);
      border: none; border-radius: 7px; color: #ef4444;
      font-size: 13px; cursor: pointer; transition: background 0.13s; font-family: inherit;
    }
    .cms-logout-btn:hover { background: rgba(239,68,68,0.2); }

    /* ── Main area ── */
    .cms-main { margin-left: 256px; flex: 1; display: flex; flex-direction: column; min-height: 100vh; }
    .cms-topbar {
      background: #fff; border-bottom: 1px solid #e2e8f0;
      padding: 0 28px; height: 60px;
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; z-index: 50;
    }
    .cms-topbar h1 { font-size: 17px; font-weight: 700; color: #0f172a; }
    .cms-content { padding: 28px; flex: 1; max-width: 1400px; width: 100%; }

    /* ── Cards ── */
    .cms-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
    .cms-card-header {
      padding: 18px 22px; border-bottom: 1px solid #f1f5f9;
      display: flex; align-items: center; justify-content: space-between; flex-wrap: gap;
    }
    .cms-card-header h2 { font-size: 15px; font-weight: 700; }
    .cms-card-body { padding: 22px; }

    /* ── Buttons ── */
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: 7px; font-size: 13.5px; font-weight: 500; cursor: pointer; text-decoration: none; border: none; font-family: inherit; transition: all 0.13s; }
    .btn-primary { background: #6366f1; color: #fff; }
    .btn-primary:hover { background: #4f46e5; color: #fff; }
    .btn-secondary { background: #f1f5f9; color: #475569; }
    .btn-secondary:hover { background: #e2e8f0; color: #334155; }
    .btn-danger { background: rgba(239,68,68,0.1); color: #ef4444; }
    .btn-danger:hover { background: rgba(239,68,68,0.2); }
    .btn-sm { padding: 5px 11px; font-size: 12.5px; }
    .btn svg { width: 15px; height: 15px; }

    /* ── Table ── */
    .cms-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
    .cms-table th { padding: 11px 14px; text-align: left; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; color: #94a3b8; border-bottom: 1px solid #f1f5f9; }
    .cms-table td { padding: 13px 14px; border-bottom: 1px solid #f8fafc; vertical-align: middle; }
    .cms-table tr:last-child td { border-bottom: none; }
    .cms-table tr:hover td { background: #fafbfd; }

    /* ── Forms ── */
    .form-group { margin-bottom: 18px; }
    .form-label { display: block; font-size: 12.5px; font-weight: 600; color: #374151; margin-bottom: 5px; }
    .form-input, .form-select, .form-textarea {
      width: 100%; padding: 9px 13px;
      border: 1.5px solid #e2e8f0; border-radius: 7px;
      font-size: 13.5px; color: #1e293b; background: #fff;
      transition: border-color 0.13s; outline: none; font-family: inherit;
    }
    .form-input:focus, .form-select:focus, .form-textarea:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.08); }
    .form-textarea { min-height: 90px; resize: vertical; }
    .form-hint { font-size: 11.5px; color: #94a3b8; margin-top: 4px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }

    /* ── Badges ── */
    .badge { display: inline-block; padding: 2px 9px; border-radius: 100px; font-size: 11.5px; font-weight: 600; }
    .badge-published { background: #dcfce7; color: #15803d; }
    .badge-draft { background: #f1f5f9; color: #64748b; }
    .badge-blog { background: #dbeafe; color: #1d4ed8; }
    .badge-publication { background: #fce7f3; color: #be185d; }

    /* ── Alerts ── */
    .alert { padding: 13px 16px; border-radius: 8px; font-size: 13.5px; margin-bottom: 18px; }
    .alert-success { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .alert-error { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

    /* ── Empty state ── */
    .cms-empty { text-align: center; padding: 52px 24px; color: #94a3b8; }
    .cms-empty svg { width: 44px; height: 44px; margin: 0 auto 14px; display: block; opacity: 0.35; }
    .cms-empty p { font-size: 14px; }

    /* ── Action row ── */
    .action-row { display: flex; gap: 8px; }

    /* ── Stats ── */
    .stat-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 18px 20px; }
    .stat-label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; }
    .stat-value { font-size: 28px; font-weight: 700; color: #0f172a; margin-top: 4px; }
    .stat-sub { font-size: 12px; color: #94a3b8; margin-top: 2px; }

    @media (max-width: 900px) {
      .cms-sidebar { width: 56px; }
      .cms-sidebar-logo span, .cms-nav a span, .cms-user-info, .cms-logout-btn span { display: none; }
      .cms-main { margin-left: 56px; }
      .stat-cards { grid-template-columns: 1fr; }
      .form-row, .form-row-3 { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="cms-wrapper">
    <aside class="cms-sidebar">
      <div class="cms-sidebar-logo">
        <img src="/img/logo/soho_logo_white.png" alt="Soho Digital" />
        <span>Content Management</span>
      </div>

      <nav class="cms-nav">
        <span class="cms-nav-label">Content</span>
        <a href="/cms/articles" class={currentPage === 'articles' ? 'active' : ''}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14,2 14,8 20,8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
          <span>Articles</span>
        </a>
        <a href="/cms/categories" class={currentPage === 'categories' ? 'active' : ''}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
          <span>Categories</span>
        </a>

        <span class="cms-nav-label" style="margin-top:12px">Portfolio</span>
        <a href="/cms/works" class={currentPage === 'works' ? 'active' : ''}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
          </svg>
          <span>Works</span>
        </a>

        <span class="cms-nav-label" style="margin-top:12px">Inquiries</span>
        <a href="/cms/contacts" class={currentPage === 'contacts' ? 'active' : ''}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          <span>Contact Submissions</span>
        </a>
      </nav>

      <div class="cms-sidebar-footer">
        <div class="cms-user-card">
          {user.avatar
            ? <img src={user.avatar} alt={user.name} class="cms-user-avatar" />
            : <div class="cms-user-avatar-placeholder">{user.name?.charAt(0)?.toUpperCase() ?? 'U'}</div>
          }
          <div class="cms-user-info">
            <div class="cms-user-name">{user.name}</div>
            <div class="cms-user-email">{user.email}</div>
          </div>
        </div>
        <form method="POST" action="/api/auth/logout">
          <button type="submit" class="cms-logout-btn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16,17 21,12 16,7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            <span>Sign out</span>
          </button>
        </form>
      </div>
    </aside>

    <div class="cms-main">
      <header class="cms-topbar">
        <h1>{title}</h1>
      </header>
      <main class="cms-content">
        <slot />
      </main>
    </div>
  </div>
</body>
</html>
