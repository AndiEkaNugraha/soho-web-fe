---
export const prerender = false;

import CMSLayout from '../../../layouts/CMSLayout.astro';
import { getSessionUser } from '../../../lib/auth';

const user = await getSessionUser(Astro.cookies.get('session')?.value);
if (!user) return Astro.redirect('/cms/login');
---

<CMSLayout title="New Work" user={user} currentPage="works">
  <link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css">
  <style>
    .ql-editor { min-height: 260px; font-size: 15px; font-family: inherit; }
    .ql-toolbar { border-radius: 7px 7px 0 0; border-color: #e2e8f0 !important; }
    .ql-container { border-radius: 0 0 7px 7px; border-color: #e2e8f0 !important; }
  </style>

  <div style="margin-bottom:16px;">
    <a href="/cms/works" class="btn btn-secondary btn-sm">← Back to Works</a>
  </div>

  <div id="alert-container"></div>

  <form id="work-form">
    <div style="display:grid; grid-template-columns:2fr 1fr; gap:24px; align-items:start;">

      <!-- Left column -->
      <div>
        <div class="cms-card" style="margin-bottom:20px;">
          <div class="cms-card-header"><h2>Basic Info</h2></div>
          <div class="cms-card-body">
            <div class="form-group">
              <label class="form-label">Project Title <span style="color:#ef4444">*</span></label>
              <input type="text" id="title" class="form-input" placeholder="e.g. Website Development Oliv+ Care™" required>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Slug <span style="color:#ef4444">*</span></label>
                <input type="text" id="slug" class="form-input" placeholder="oliv-care (auto-filled)">
                <div class="form-hint">URL: /work/{slug}</div>
              </div>
              <div class="form-group">
                <label class="form-label">Client Name</label>
                <input type="text" id="client_name" class="form-input" placeholder="e.g. Oliv+ Care™">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Category / Service</label>
                <input type="text" id="category" class="form-input" placeholder="Website Design & Development">
              </div>
              <div class="form-group">
                <label class="form-label">Year</label>
                <input type="text" id="year" class="form-input" placeholder="2025">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Website URL</label>
              <input type="text" id="website_url" class="form-input" placeholder="https://olivpluscare.com">
            </div>
          </div>
        </div>

        <div class="cms-card" style="margin-bottom:20px;">
          <div class="cms-card-header"><h2>Overview</h2></div>
          <div class="cms-card-body">
            <div class="form-group">
              <div id="quill-editor"></div>
              <input type="hidden" id="overview">
            </div>
          </div>
        </div>

        <div class="cms-card" style="margin-bottom:20px;">
          <div class="cms-card-header"><h2>Highlight Section</h2></div>
          <div class="cms-card-body">
            <div class="form-group">
              <label class="form-label">Quote</label>
              <input type="text" id="highlight_quote" class="form-input" value="Simplicity, elegance, innovation!">
            </div>
            <div class="form-group">
              <label class="form-label">Body Text</label>
              <textarea id="highlight_body" class="form-textarea" rows="6" placeholder="Enter paragraphs separated by blank line...">Kami hidup dari ide-ide besar dan teknologi. Di Soho, kami mengubah visi menjadi solusi digital yang nyata dari pengembangan website dan sistem, hingga strategi IT yang mendorong bisnis ke level berikutnya.

Dengan perpaduan keahlian di bidang desain, teknologi, dan konsultasi, kami menciptakan pengalaman digital yang tidak hanya terlihat menarik, tapi juga berfungsi dengan sempurna. Setiap proyek kami lahir dari kolaborasi erat, inovasi, dan semangat untuk menghadirkan solusi yang melampaui ekspektasi.

Kami tidak hanya membangun website atau sistem, kami membangun fondasi digital yang membuat bisnis Anda tumbuh, dikenal, dan dipercaya.</textarea>
              <div class="form-hint">Each paragraph separated by a blank line</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right column -->
      <div>
        <div class="cms-card" style="margin-bottom:16px;">
          <div class="cms-card-header"><h2>Settings</h2></div>
          <div class="cms-card-body">
            <div class="form-group">
              <label class="form-label">Status</label>
              <select id="status" class="form-select">
                <option value="draft">Draft</option>
                <option value="published">Published</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Cover Image (listing page)</label>
              <input type="text" id="cover_image" class="form-input" placeholder="/img/works/project/1.png">
              <div class="form-hint">Thumbnail shown on /works listing</div>
            </div>
            <div class="form-group">
              <label class="form-label">Logo URL</label>
              <input type="text" id="logo_url" class="form-input" placeholder="/logo/client.png">
            </div>
            <div class="form-group">
              <label class="form-label">Banner URL</label>
              <input type="text" id="banner_url" class="form-input" placeholder="/img/works/project/banner.mp4">
            </div>
            <div class="form-group">
              <label class="form-label">Banner Type</label>
              <select id="banner_type" class="form-select">
                <option value="video">Video</option>
                <option value="image">Image</option>
              </select>
            </div>
          </div>
        </div>

        <div class="cms-card" style="margin-bottom:16px;">
          <div class="cms-card-header"><h2>Colors</h2></div>
          <div class="cms-card-body">
            <div class="form-group">
              <label class="form-label">Page Background</label>
              <div style="display:flex;gap:8px;align-items:center;">
                <input type="color" id="bg_color_picker" value="#e9e8e9" style="width:36px;height:36px;border:none;border-radius:6px;cursor:pointer;padding:2px;" oninput="document.getElementById('bg_color').value=this.value">
                <input type="text" id="bg_color" class="form-input" value="#e9e8e9" style="flex:1;" oninput="document.getElementById('bg_color_picker').value=this.value">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Gallery Background</label>
              <div style="display:flex;gap:8px;align-items:center;">
                <input type="color" id="grid_bg_color_picker" value="#dedbdf" style="width:36px;height:36px;border:none;border-radius:6px;cursor:pointer;padding:2px;" oninput="document.getElementById('grid_bg_color').value=this.value">
                <input type="text" id="grid_bg_color" class="form-input" value="#dedbdf" style="flex:1;" oninput="document.getElementById('grid_bg_color_picker').value=this.value">
              </div>
            </div>
            <div class="form-group">
              <label class="form-label">Category Label Color</label>
              <div style="display:flex;gap:8px;align-items:center;">
                <input type="color" id="accent_color_picker" value="#000000" style="width:36px;height:36px;border:none;border-radius:6px;cursor:pointer;padding:2px;" oninput="document.getElementById('accent_color').value=this.value">
                <input type="text" id="accent_color" class="form-input" value="#000000" style="flex:1;" oninput="document.getElementById('accent_color_picker').value=this.value">
              </div>
            </div>
          </div>
        </div>

        <div class="cms-card" style="margin-bottom:16px;">
          <div class="cms-card-header"><h2>SEO Meta</h2></div>
          <div class="cms-card-body">
            <div class="form-group">
              <label class="form-label">Meta Title</label>
              <input type="text" id="meta_title" class="form-input" placeholder="Defaults to project title">
            </div>
            <div class="form-group">
              <label class="form-label">Meta Description</label>
              <textarea id="meta_description" class="form-textarea" rows="3" placeholder="Short description for search engines"></textarea>
            </div>
          </div>
        </div>

        <div class="alert" style="background:#f0fdf4;border:1px solid #bbf7d0;color:#166534;border-radius:8px;padding:12px 16px;font-size:13px;margin-bottom:16px;">
          💡 Gallery images can be added after saving.
        </div>

        <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:12px;" id="submit-btn">
          Save & Continue to Gallery
        </button>
      </div>

    </div>
  </form>

  <script src="https://cdn.quilljs.com/1.3.7/quill.min.js" is:inline></script>
  <script is:inline>
    const quill = new Quill('#quill-editor', {
      theme: 'snow',
      modules: { toolbar: [[{header:[1,2,3,false]}],['bold','italic','underline'],['blockquote'],['link'],['clean']] }
    });

    // Auto-slug from title
    document.getElementById('title').addEventListener('input', function() {
      if (!document.getElementById('slug').dataset.manual) {
        document.getElementById('slug').value = this.value
          .toLowerCase().trim()
          .replace(/[^a-z0-9\s-]/g,'')
          .replace(/\s+/g,'-')
          .replace(/-+/g,'-');
      }
    });
    document.getElementById('slug').addEventListener('input', function() {
      this.dataset.manual = '1';
    });

    document.getElementById('work-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      document.getElementById('overview').value = quill.root.innerHTML === '<p><br></p>' ? '' : quill.root.innerHTML;

      const btn = document.getElementById('submit-btn');
      btn.disabled = true; btn.textContent = 'Saving…';

      const data = {
        title: document.getElementById('title').value,
        slug: document.getElementById('slug').value,
        client_name: document.getElementById('client_name').value,
        category: document.getElementById('category').value,
        year: document.getElementById('year').value,
        website_url: document.getElementById('website_url').value,
        logo_url: document.getElementById('logo_url').value,
        cover_image: document.getElementById('cover_image').value,
        banner_url: document.getElementById('banner_url').value,
        banner_type: document.getElementById('banner_type').value,
        bg_color: document.getElementById('bg_color').value,
        grid_bg_color: document.getElementById('grid_bg_color').value,
        accent_color: document.getElementById('accent_color').value,
        overview: document.getElementById('overview').value,
        highlight_quote: document.getElementById('highlight_quote').value,
        highlight_body: document.getElementById('highlight_body').value,
        meta_title: document.getElementById('meta_title').value,
        meta_description: document.getElementById('meta_description').value,
        status: document.getElementById('status').value,
      };

      try {
        const res = await fetch('/api/cms/works', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (res.ok) {
          window.location.href = `/cms/works/${json.id}`;
        } else {
          document.getElementById('alert-container').innerHTML =
            `<div class="alert alert-error">${json.error || 'Failed to save.'}</div>`;
          btn.disabled = false; btn.textContent = 'Save & Continue to Gallery';
        }
      } catch {
        document.getElementById('alert-container').innerHTML =
          `<div class="alert alert-error">Server error. Please try again.</div>`;
        btn.disabled = false; btn.textContent = 'Save & Continue to Gallery';
      }
    });
  </script>
</CMSLayout>
