---
export const prerender = false;

import { getSessionUser } from '../../lib/auth';

const user = await getSessionUser(Astro.cookies.get('session')?.value);
if (user) return Astro.redirect('/cms/articles');

const error = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  invalid_state: 'Invalid OAuth state. Please try again.',
  auth_failed: 'Authentication failed. Please try again.',
  unauthorized: 'Your email is not authorized to access the CMS.',
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CMS Login – Soho Solusi Digital</title>
  <link rel="icon" type="image/png" href="/fav.png">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0f172a;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .login-card {
      background: #fff;
      border-radius: 16px;
      padding: 48px 40px;
      width: 100%;
      max-width: 400px;
      text-align: center;
      box-shadow: 0 25px 50px rgba(0,0,0,0.4);
    }
    .login-logo { margin-bottom: 24px; }
    .login-logo img { height: 36px; width: auto; }
    .login-badge {
      display: inline-block;
      background: #f1f5f9;
      color: #64748b;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      padding: 4px 12px;
      border-radius: 100px;
      margin-bottom: 20px;
    }
    .login-title { font-size: 22px; font-weight: 700; color: #0f172a; margin-bottom: 8px; }
    .login-desc { font-size: 14px; color: #64748b; margin-bottom: 32px; line-height: 1.6; }
    .btn-google {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
      padding: 13px 20px;
      background: #fff;
      border: 2px solid #e2e8f0;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      color: #1e293b;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.15s;
      font-family: inherit;
    }
    .btn-google:hover { border-color: #6366f1; background: #fafafe; color: #1e293b; }
    .btn-google svg { width: 20px; height: 20px; flex-shrink: 0; }
    .login-error {
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fecaca;
      border-radius: 8px;
      padding: 11px 14px;
      font-size: 13px;
      margin-bottom: 20px;
      text-align: left;
    }
    .login-footer { margin-top: 28px; font-size: 12px; color: #94a3b8; }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="login-logo">
      <img src="/img/logo/soho_logo_black.png" alt="Soho Solusi Digital" />
    </div>
    <div class="login-badge">Content Management</div>
    <h1 class="login-title">Sign in to CMS</h1>
    <p class="login-desc">Manage articles, categories, and contact submissions for Soho Solusi Digital.</p>

    {error && (
      <div class="login-error">
        {errorMessages[error] ?? 'An error occurred. Please try again.'}
      </div>
    )}

    <a href="/api/auth/google" class="btn-google">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
      </svg>
      Continue with Google
    </a>

    <div class="login-footer">
      Only authorized accounts can access this CMS.
    </div>
  </div>
</body>
</html>
