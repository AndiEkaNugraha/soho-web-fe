---
export const prerender = false;

import CMSLayout from '../../../layouts/CMSLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { query } from '../../../lib/db';

const user = await getSessionUser(Astro.cookies.get('session')?.value);
if (!user) return Astro.redirect('/cms/login');

const articles = await query(
  `SELECT a.id, a.title, a.slug, a.type, a.status, a.published_at, a.created_at,
          c.name as category_name
   FROM articles a
   LEFT JOIN categories c ON a.category_id = c.id
   ORDER BY a.created_at DESC`
).then(r => r.rows).catch(() => []);

const totalPublished = articles.filter((a: any) => a.status === 'published').length;
const totalDraft = articles.filter((a: any) => a.status === 'draft').length;

function formatDate(d: string | Date) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<CMSLayout title="Articles" user={user} currentPage="articles">
  <div class="stat-cards">
    <div class="stat-card">
      <div class="stat-label">Total Articles</div>
      <div class="stat-value">{articles.length}</div>
      <div class="stat-sub">all articles</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Published</div>
      <div class="stat-value">{totalPublished}</div>
      <div class="stat-sub">visible at /blog</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Draft</div>
      <div class="stat-value">{totalDraft}</div>
      <div class="stat-sub">not yet published</div>
    </div>
  </div>

  <div class="cms-card">
    <div class="cms-card-header">
      <h2>All Articles</h2>
      <a href="/cms/articles/new" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Article
      </a>
    </div>

    {articles.length === 0 ? (
      <div class="cms-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/></svg>
        <p>No articles yet. <a href="/cms/articles/new" style="color:#6366f1">Create the first one.</a></p>
      </div>
    ) : (
      <div style="overflow-x: auto;">
        <table class="cms-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Category</th>
              <th>Status</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {articles.map((article: any) => (
              <tr>
                <td>
                  <div style="font-weight:600; color:#0f172a; max-width:380px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                    {article.title}
                  </div>
                  <div style="font-size:12px; color:#94a3b8; margin-top:2px;">/blog/{article.slug}</div>
                </td>
                <td style="color:#64748b;">{article.category_name ?? '—'}</td>
                <td>
                  <span class={`badge badge-${article.status}`}>{article.status}</span>
                </td>
                <td style="color:#64748b; white-space:nowrap;">
                  {article.status === 'published' ? formatDate(article.published_at) : formatDate(article.created_at)}
                </td>
                <td>
                  <div class="action-row">
                    <a href={`/cms/articles/${article.id}`} class="btn btn-secondary btn-sm">Edit</a>
                    <a href={`/blog/${article.slug}`} target="_blank" class="btn btn-secondary btn-sm">View</a>
                    <button
                      class="btn btn-danger btn-sm"
                      data-id={article.id}
                      data-title={article.title}
                      onclick="deleteArticle(this)"
                    >Delete</button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</CMSLayout>

<script is:inline>
  async function deleteArticle(btn) {
    if (!confirm(`Delete "${btn.dataset.title}"? This cannot be undone.`)) return;
    btn.disabled = true;
    btn.textContent = '…';
    try {
      const res = await fetch(`/api/cms/articles/${btn.dataset.id}`, { method: 'DELETE' });
      if (res.ok) location.reload();
      else throw new Error();
    } catch {
      alert('Failed to delete article.');
      btn.disabled = false;
      btn.textContent = 'Delete';
    }
  }
</script>
